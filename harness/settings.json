{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(date)",
      "Bash(~/.local/bin/wisp topic:*)",
      "Bash(~/.local/bin/wisp aprender listar:*)",
      "WebSearch"
    ],
    "ask": [
      "Bash(*aprender add*)",
      "Bash(*aprender confirmar*)",
      "Bash(*aprender descartar*)",
      "Bash(\"$WISP_BIN\" agenda criar-evento:*)",
      "Bash($WISP_BIN agenda criar-evento:*)",
      "Bash(wisp agenda criar-evento:*)",
      "Bash(\"$WISP_AGENDA_BIN\" criar-evento:*)",
      "Bash(\"$WISP_BIN\" agenda editar-evento:*)",
      "Bash($WISP_BIN agenda editar-evento:*)",
      "Bash(wisp agenda editar-evento:*)",
      "Bash(\"$WISP_AGENDA_BIN\" editar-evento:*)",
      "Bash(\"$WISP_BIN\" agenda apagar-evento:*)",
      "Bash($WISP_BIN agenda apagar-evento:*)",
      "Bash(wisp agenda apagar-evento:*)",
      "Bash(\"$WISP_AGENDA_BIN\" apagar-evento:*)",
      "Bash(\"$WISP_BIN\" agenda criar-lembrete:*)",
      "Bash($WISP_BIN agenda criar-lembrete:*)",
      "Bash(wisp agenda criar-lembrete:*)",
      "Bash(\"$WISP_AGENDA_BIN\" criar-lembrete:*)",
      "Bash(\"$WISP_BIN\" agenda concluir-lembrete:*)",
      "Bash($WISP_BIN agenda concluir-lembrete:*)",
      "Bash(wisp agenda concluir-lembrete:*)",
      "Bash(\"$WISP_AGENDA_BIN\" concluir-lembrete:*)",
      "Bash(\"$WISP_BIN\" agenda permissao --pedir:*)",
      "Bash($WISP_BIN agenda permissao --pedir:*)",
      "Bash(wisp agenda permissao --pedir:*)",
      "Bash(\"$WISP_AGENDA_BIN\" permissao --pedir:*)",
      "mcp__wisp-email__email_send"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(sudo *)",
      "Read(~/.config/wisp/secrets/**)",
      "Bash(cat *wisp/secrets*)",
      "Bash(grep *wisp/secrets*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.local/bin/wisp hook guard-secrets"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.local/bin/wisp hook guard-telegram"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.local/bin/wisp hook guard-destructive"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.local/bin/wisp hook guard-lessons"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.local/bin/wisp hook guard-agenda"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.local/bin/wisp hook guard-outbound"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.local/bin/wisp hook recall",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.local/bin/wisp hook boot"
          },
          {
            "type": "command",
            "command": "\"$HOME\"/.local/bin/wisp hook aprendizados",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.local/bin/wisp hook brain-commit"
          }
        ]
      }
    ]
  }
}
