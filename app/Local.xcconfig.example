// Optional, git-ignored: copy to app/Local.xcconfig to sign local builds with
// your own identity instead of ad-hoc. A stable identity keeps the same
// designated requirement across builds, so Keychain "Always Allow" and macOS
// privacy grants survive a rebuild. Run `xcodegen generate` after creating it.
// List identities with: security find-identity -v -p codesigning
CODE_SIGN_IDENTITY = Wisp Self-Signed
CODE_SIGN_STYLE = Manual
