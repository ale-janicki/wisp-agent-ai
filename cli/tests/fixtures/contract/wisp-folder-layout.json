{
  "version": 1,
  "placeholder": "{home}",
  "cases": [
    {
      "name": "no config file",
      "env": {},
      "config": null,
      "expect": {
        "config_file": "{home}/.config/wisp/wisp.json",
        "root": "{home}/Wisp",
        "conversas": "{home}/Wisp/conversas",
        "reunioes": "{home}/Wisp/reunioes",
        "brain": "{home}/Wisp/brain",
        "anexos": "{home}/Wisp/anexos",
        "skills": "{home}/Wisp/skills",
        "ferramentas": "{home}/Wisp/ferramentas",
        "logs": "{home}/Wisp/logs",
        "agente": "{home}/Wisp/agente.md",
        "guardrails": "{home}/Wisp/guardrails.toml",
        "modelos": "{home}/Wisp/modelos.toml",
        "modelos_pasta": "{home}/Wisp/modelos"
      }
    },
    {
      "name": "empty wisp_dir falls back",
      "env": {},
      "config": {
        "wisp_dir": ""
      },
      "expect": {
        "config_file": "{home}/.config/wisp/wisp.json",
        "root": "{home}/Wisp",
        "conversas": "{home}/Wisp/conversas",
        "reunioes": "{home}/Wisp/reunioes",
        "brain": "{home}/Wisp/brain",
        "anexos": "{home}/Wisp/anexos",
        "skills": "{home}/Wisp/skills",
        "ferramentas": "{home}/Wisp/ferramentas",
        "logs": "{home}/Wisp/logs",
        "agente": "{home}/Wisp/agente.md",
        "guardrails": "{home}/Wisp/guardrails.toml",
        "modelos": "{home}/Wisp/modelos.toml",
        "modelos_pasta": "{home}/Wisp/modelos"
      }
    },
    {
      "name": "tilde wisp_dir with space and accent",
      "env": {},
      "config": {
        "wisp_dir": "~/Documents/Meu Wisp ç"
      },
      "expect": {
        "config_file": "{home}/.config/wisp/wisp.json",
        "root": "{home}/Documents/Meu Wisp ç",
        "conversas": "{home}/Documents/Meu Wisp ç/conversas",
        "reunioes": "{home}/Documents/Meu Wisp ç/reunioes",
        "brain": "{home}/Documents/Meu Wisp ç/brain",
        "anexos": "{home}/Documents/Meu Wisp ç/anexos",
        "skills": "{home}/Documents/Meu Wisp ç/skills",
        "ferramentas": "{home}/Documents/Meu Wisp ç/ferramentas",
        "logs": "{home}/Documents/Meu Wisp ç/logs",
        "agente": "{home}/Documents/Meu Wisp ç/agente.md",
        "guardrails": "{home}/Documents/Meu Wisp ç/guardrails.toml",
        "modelos": "{home}/Documents/Meu Wisp ç/modelos.toml",
        "modelos_pasta": "{home}/Documents/Meu Wisp ç/modelos"
      }
    },
    {
      "name": "absolute wisp_dir",
      "env": {},
      "config": {
        "wisp_dir": "/Volumes/Disco/Wisp"
      },
      "expect": {
        "config_file": "{home}/.config/wisp/wisp.json",
        "root": "/Volumes/Disco/Wisp",
        "conversas": "/Volumes/Disco/Wisp/conversas",
        "reunioes": "/Volumes/Disco/Wisp/reunioes",
        "brain": "/Volumes/Disco/Wisp/brain",
        "anexos": "/Volumes/Disco/Wisp/anexos",
        "skills": "/Volumes/Disco/Wisp/skills",
        "ferramentas": "/Volumes/Disco/Wisp/ferramentas",
        "logs": "/Volumes/Disco/Wisp/logs",
        "agente": "/Volumes/Disco/Wisp/agente.md",
        "guardrails": "/Volumes/Disco/Wisp/guardrails.toml",
        "modelos": "/Volumes/Disco/Wisp/modelos.toml",
        "modelos_pasta": "/Volumes/Disco/Wisp/modelos"
      }
    },
    {
      "name": "brain repointed",
      "env": {},
      "config": {
        "brain": "~/vault"
      },
      "expect": {
        "config_file": "{home}/.config/wisp/wisp.json",
        "root": "{home}/Wisp",
        "conversas": "{home}/Wisp/conversas",
        "reunioes": "{home}/Wisp/reunioes",
