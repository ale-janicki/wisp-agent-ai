        "ferramentas": "{home}/Wisp/ferramentas",
        "logs": "{home}/Wisp/logs",
        "agente": "{home}/Wisp/agente.md",
        "guardrails": "{home}/Wisp/guardrails.toml",
        "modelos": "{home}/Wisp/modelos.toml",
        "modelos_pasta": "{home}/Wisp/modelos"
      }
    },
    {
      "name": "brain follows a moved Wisp folder",
      "env": {},
      "config": {
        "wisp_dir": "~/Dados/Wisp"
      },
      "expect": {
        "config_file": "{home}/.config/wisp/wisp.json",
        "root": "{home}/Dados/Wisp",
        "conversas": "{home}/Dados/Wisp/conversas",
        "reunioes": "{home}/Dados/Wisp/reunioes",
        "brain": "{home}/Dados/Wisp/brain",
        "anexos": "{home}/Dados/Wisp/anexos",
        "skills": "{home}/Dados/Wisp/skills",
        "ferramentas": "{home}/Dados/Wisp/ferramentas",
        "logs": "{home}/Dados/Wisp/logs",
        "agente": "{home}/Dados/Wisp/agente.md",
        "guardrails": "{home}/Dados/Wisp/guardrails.toml",
        "modelos": "{home}/Dados/Wisp/modelos.toml",
        "modelos_pasta": "{home}/Dados/Wisp/modelos"
      }
    },
    {
      "name": "XDG_CONFIG_HOME",
      "env": {
        "XDG_CONFIG_HOME": "{home}/xdg"
      },
      "config": {
        "wisp_dir": "~/W"
      },
      "expect": {
        "config_file": "{home}/xdg/wisp/wisp.json",
        "root": "{home}/W",
        "conversas": "{home}/W/conversas",
        "reunioes": "{home}/W/reunioes",
        "brain": "{home}/W/brain",
        "anexos": "{home}/W/anexos",
        "skills": "{home}/W/skills",
        "ferramentas": "{home}/W/ferramentas",
