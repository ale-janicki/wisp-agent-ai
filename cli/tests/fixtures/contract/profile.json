{
  "persona": {
    "name": "Ada",
    "user": "Rita",
    "language": "pt-BR"
  },
  "agent": {
    "cwd": "~"
  },
  "blocks": {
    "tasks": {
      "file": "/home/rita/Wisp/brain/pendencias.md"
    },
    "memory": {
      "search": "/usr/bin/grep -rIin --null --include='*.md' --exclude-dir='.*' -m 1 -F -e {query} {root} | head -n 200",
      "root": "/home/rita/Wisp/brain"
    },
    "telegram": {
      "status": "/opt/wisp/venv/bin/wisp topic status --json",
      "list": "/opt/wisp/venv/bin/wisp topic listar --json",
      "share": "/opt/wisp/venv/bin/wisp topic compartilhar --session={session} --cwd={cwd} --nome={name} --json",
      "post": "/opt/wisp/venv/bin/wisp topic postar --json",
      "close": "/opt/wisp/venv/bin/wisp topic encerrar --sem-pull {thread}",
      "attachments": "/state/anexos"
    }
  }
}
