import { useState, type ReactNode } from "react";
import styles from "./Settings.module.css";

const cx = (...names: (string | false | undefined)[]) => names.filter(Boolean).join(" ");

export function Group({ title, caption, children }: { title: string; caption?: string; children: ReactNode }) {
  return (
    <section className={styles.group} aria-label={title}>
      <h3 className={styles.groupTitle}>{title}</h3>
      {caption && <p className={styles.caption}>{caption}</p>}
      {children}
    </section>
  );
}

export const Divider = () => <hr className={styles.divider} />;

export function Row({ title, detail, detailTone, children }: { title: string; detail?: string | null; detailTone?: "error"; children?: ReactNode }) {
  return (
    <div className={styles.row}>
      <div className={styles.label}>
        <span className={styles.title}>{title}</span>
        {detail && <span className={detailTone === "error" ? styles.error : styles.detail}>{detail}</span>}
      </div>
      {children && <div className={styles.controls}>{children}</div>}
    </div>
  );
}

export function ToggleRow({ title, detail, detailTone, on, enabled = true, onChange }: {
  title: string;
  detail?: string | null;
  detailTone?: "error";
  on: boolean;
  enabled?: boolean;
  onChange: (on: boolean) => void;
}) {
  return (
    <Row title={title} detail={detail} detailTone={detailTone}>
      <button
        type="button"
        role="switch"
        aria-label={title}
        aria-checked={on}
        disabled={!enabled}
        className={cx(styles.switch, on && styles.switchOn)}
        onClick={() => onChange(!on)}
      />
    </Row>
  );
}

export function Button({ children, kind, ...rest }: { kind?: "accent" | "danger" } & React.ButtonHTMLAttributes<HTMLButtonElement>) {
  return (
    <button type="button" {...rest} className={cx(styles.btn, kind === "accent" && styles.btnAccent, kind === "danger" && styles.btnDanger)}>
      {children}
    </button>
  );
}

export function TextInput(props: React.InputHTMLAttributes<HTMLInputElement>) {
  return <input {...props} className={styles.input} />;
}

export function Dot({ tone }: { tone: "ok" | "busy" | "error" | "ring" | "plain" }) {
  const map = { ok: styles.dotOk, busy: styles.dotBusy, error: styles.dotError, ring: styles.dotRing, plain: undefined };
  return <span className={cx(styles.dot, map[tone])} aria-hidden />;
}

export function Radio({ selected, title, detail, titleTone, disabled, onSelect }: {
  selected: boolean;
  title: string;
  detail: string;
  titleTone?: "error";
  disabled?: boolean;
  onSelect: () => void;
}) {
  return (
    <button type="button" role="radio" aria-checked={selected} className={styles.radio} disabled={disabled} onClick={onSelect}>
      <Dot tone={selected ? "ok" : "ring"} />
      <span className={styles.label}>
        <span className={cx(styles.title, titleTone === "error" && styles.error)}>{title}</span>
        <span className={styles.detail}>{detail}</span>
      </span>
    </button>
  );
}

export function Expander({ title, summary, open, onToggle, children }: {
  title: string;
  summary?: string | null;
  open: boolean;
  onToggle: () => void;
  children: ReactNode;
}) {
  return (
    <div>
      <button type="button" className={styles.expander} aria-expanded={open} onClick={onToggle}>
        <span className={styles.title}>{title}</span>
        <span style={{ flex: 1 }} />
        {summary && <span className={styles.dim}>{summary}</span>}
        <span className={cx(styles.chevron, open && styles.chevronOpen)} aria-hidden>
          ›
        </span>
      </button>
      {open && <div className={styles.expanded}>{children}</div>}
    </div>
  );
}

/** A destructive-or-slow action asks first, like the Mac's ConfirmAction. */
export function ConfirmAction({ label, question, busy, onConfirm }: { label: string; question: string; busy?: boolean; onConfirm: () => void }) {
  const [asking, setAsking] = useState(false);
  if (busy) return <span className={styles.busy}>…</span>;
  if (!asking) return <Button onClick={() => setAsking(true)}>{label}</Button>;
  return (
    <span className={styles.controls}>
      <span className={styles.detail}>{question}</span>
      <Button
        kind="accent"
        onClick={() => {
          setAsking(false);
          onConfirm();
        }}
      >
        Sim
      </Button>
      <Button onClick={() => setAsking(false)}>Cancelar</Button>
    </span>
  );
}

export const InlineError = ({ text }: { text: string }) => <p className={styles.error}>{text}</p>;
export const Detail = ({ text, mono }: { text: string; mono?: boolean }) => <p className={cx(styles.detail, mono && styles.mono)}>{text}</p>;
export const Empty = ({ text }: { text: string }) => <p className={cx(styles.detail, styles.title)}>{text}</p>;
export const sentence = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
export { cx };
